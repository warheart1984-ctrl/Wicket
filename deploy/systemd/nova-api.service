# Nova's API, governed by the signer service. Install as /etc/systemd/system/nova-api.service.
# Nova holds no policy, no signing key and no kernel binary: setting NOVA_ICK_POLICY, NOVA_ICK_SIGN_KEY
# or NOVA_ICK_BIN next to NOVA_ICK_SERVICE is refused at startup. See deploy/README.md.
[Unit]
Description=Nova shell API (governed by the Infinity signer service)
Documentation=file:///opt/infinity-core/deploy/README.md
After=network-online.target ick-signer.service
Wants=network-online.target ick-signer.service

[Service]
Type=simple
User=nova
Group=nova
# Lets Nova reach /run/ick/ick.sock. Nothing else.
SupplementaryGroups=ick-socket
WorkingDirectory=/var/lib/nova
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOVA_ICK_SERVICE=/run/ick/ick.sock
# The human-written approvals file (read only for Nova) and where Nova parks pending requests.
Environment=NOVA_ICK_APPROVALS=/etc/ick/human/approvals.jsonl
Environment=NOVA_ICK_STATE=/var/lib/nova/ick-state
Environment=NOVA_ICK_PENDING_TTL=604800
Environment=NOVA_PORT=8080
# Provider settings and API keys (NOVA_PROVIDER, NOVA_EXTERNAL_URL, NOVA_EXTERNAL_API_KEY, ...).
EnvironmentFile=-/etc/nova/nova.env
ExecStart=/opt/infinity-core/venv/bin/python -m nova.api
Restart=on-failure
RestartSec=3
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nova
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
