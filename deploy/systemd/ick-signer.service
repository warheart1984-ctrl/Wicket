# The signer service: holds the signing key, the policy and the receipt log, and runs the kernel for
# Nova. Install as /etc/systemd/system/ick-signer.service. See deploy/README.md before enabling it.
[Unit]
Description=Infinity signer service (kernel, signing key and receipt log)
Documentation=file:///opt/infinity-core/deploy/README.md
After=local-fs.target

[Service]
Type=simple
# Its own account. The group is the one allowed to reach the socket (Nova's account is a member),
# not the group that may read the log (see tmpfiles.d: the log directories are setgid ick-audit).
User=ick-signer
Group=ick-socket
WorkingDirectory=/opt/infinity-core
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m runtime.ick_service serve \
    --socket /run/ick/ick.sock --socket-mode 660 \
    --policy /etc/ick/policy.json \
    --log /var/lib/ick/log/receipts.jsonl \
    --anchor /var/lib/ick/anchor/anchor.jsonl \
    --sign-key /etc/ick/signing.priv \
    --approvals /etc/ick/human/approvals.jsonl \
    --binary /opt/infinity-core/target/release/infinityctl
Restart=on-failure
RestartSec=2
# Stop cleanly: the service removes its socket on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=15

# /run/ick is created for this service: owned by ick-signer, group ick-socket, so Nova can reach the socket.
RuntimeDirectory=ick
RuntimeDirectoryMode=0750
# Files it creates (log, anchor) are readable by the group, never writable by anyone else.
UMask=0027

# Hardening. It needs no network at all and writes only to /var/lib/ick.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ick
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
