# Install as /etc/ick-publisher/ick-anchor-watch.env (owner ick-publisher, mode 0600).
# The git URL of the SEPARATE repository the anchor is published to. Use a deploy key that can push
# to that repository only. The URL is never written to the status file or the operator screen.
ANCHOR_REPO=git@github.com:YOUR-ORG/YOUR-ANCHOR-REPO.git
# Seconds between publishes. The operator screen calls the anchor stale after 900 s by default
# (--anchor-stale-after), so keep this well below that.
ANCHOR_INTERVAL=300
# The file the anchor is published as, inside that repository. Leave it alone until you rotate the log; then
# give the NEW log a new name (anchor-2.jsonl, anchor-3.jsonl, ...). Reusing a name is refused, on purpose.
# ANCHOR_NAME=anchor.jsonl
