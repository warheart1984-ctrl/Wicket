# Install as /etc/nova/nova.env (owner root, group nova, mode 0640). Provider settings and keys only.
# Do NOT put NOVA_ICK_POLICY, NOVA_ICK_SIGN_KEY, NOVA_ICK_BIN or NOVA_ICK_LOG here: with the signer
# service those belong to the service, and Nova refuses to start if some are set.
# Do NOT set WICKET_ALLOW_DIRECT_CALLS. That opt-out skips the witness and is for local development only.
NOVA_PROVIDER=external
NOVA_EXTERNAL_URL=https://api.groq.com/openai/v1
NOVA_EXTERNAL_MODEL=openai/gpt-oss-120b
NOVA_EXTERNAL_API_KEY=replace-me
